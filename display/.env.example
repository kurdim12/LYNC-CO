# ── Liv display configuration (build-time; NEXT_PUBLIC_* is inlined at build) ──

# The bot's WebRTC endpoint. The browser POSTs its SDP offer to {URL}/api/offer.
#   Local dev (python bot.py):   http://localhost:7860
#   Production:                   https://your-bot-host        (Pipecat Cloud / VM)
# NOTE: cross-origin + public WebRTC needs CORS on the bot + a TURN server (see DEPLOY.md).
NEXT_PUBLIC_BOT_URL=http://localhost:7860

# Live captions on the display (true | false)
NEXT_PUBLIC_SHOW_CAPTIONS=true

# Attract-screen headline shown when no one is connected
NEXT_PUBLIC_ATTRACT_HEADLINE=Meet Liv
