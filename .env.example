# ============================================================================
# LIV — environment variables.  Copy to .env and fill in.  NEVER commit .env.
# Every variable below is read by bot.py.  Sensible defaults are shown in (parens).
# ============================================================================

# ── STT: Deepgram (Levantine + EN, Nova-3 multilingual) — §6.2 ───────────────
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# Code-switch EN+Arabic uses "multi". If Nova-3 'multi' doesn't transcribe
# Jordanian colloquial well in the spike, try DEEPGRAM_LANGUAGE=ar.
# DEEPGRAM_LANGUAGE=multi

# ── LLM brain — default GPT-4o; A/B Claude & Gemini in the spike — §6.3, §16 ──
# LLM_PROVIDER=openai          # openai | anthropic | google
# LLM_MODEL=                   # defaults: gpt-4o / claude-sonnet-4-5 / gemini-2.0-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=            # optional, only if LLM_PROVIDER=anthropic
GEMINI_API_KEY=              # optional, only if LLM_PROVIDER=google

# ── TTS: voice engine — pick one with TTS_PROVIDER (§4, §6.4, §9) ─────────────
# TTS_PROVIDER=elevenlabs      # elevenlabs | openai | cartesia | azure
#
# elevenlabs (default): most natural; multilingual_v2 sounds FAR better than 'flash'.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=         # pick a good voice at elevenlabs.io → Voices (or clone one)
# ELEVENLABS_MODEL=eleven_multilingual_v2   # quality; use eleven_flash_v2_5 for low latency
# ELEVENLABS_STABILITY=0.35   # lower = more expressive (too high = flat/robotic)
# ELEVENLABS_STYLE=0.65       # higher = more "into it"
#
# openai: REUSES your OPENAI_API_KEY (no extra account!). Steerable, very natural.
#   TTS_PROVIDER=openai
#   OPENAI_TTS_VOICE=coral     # alloy|ash|ballad|coral|echo|fable|onyx|nova|sage|shimmer|verse
#   OPENAI_TTS_MODEL=gpt-4o-mini-tts
#   OPENAI_TTS_INSTRUCTIONS=Warm, upbeat, natural — a cool brand host.
#
# azure: authentic Jordanian/Levantine voices (needs  pip install "pipecat-ai[azure]")
#   TTS_PROVIDER=azure
#   AZURE_SPEECH_API_KEY=      AZURE_SPEECH_REGION=        AZURE_TTS_VOICE=ar-JO-SanaNeural
#
# cartesia: very low latency (needs  pip install "pipecat-ai[cartesia]")
#   TTS_PROVIDER=cartesia      CARTESIA_API_KEY=          CARTESIA_VOICE_ID=

# ── Face: Simli (Trinity) — §6.5 ─────────────────────────────────────────────
SIMLI_API_KEY=
SIMLI_FACE_ID=              # created from the generated Liv image (Phase 1)
# SIMLI_TRINITY=true         # Trinity avatar (expressive). For "faceId/emotionId" pass it in SIMLI_FACE_ID.

# ── Display / runtime ─────────────────────────────────────────────────────────
# Lock to the venue screen early — portrait vs landscape changes face framing (§5, §21).
# VIDEO_OUT_WIDTH=768
# VIDEO_OUT_HEIGHT=1024
# IDLE_TIMEOUT_SECS=300       # release Simli minutes when idle (§6.5, §12, §15)
# LOG_LEVEL=INFO              # DEBUG for verbose frame logging (§19)
